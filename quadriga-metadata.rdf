    <schema:description>Dieses Buch dokumentiert die technische Infrastruktur des QUADRIGA Space: Architektur und Zusammenspiel der Komponenten, Administration und Betrieb sowie Fragen der Verstetigung. Es richtet sich an Betreiber:innen und Administrator:innen der QUADRIGA-Infrastruktur.</schema:description>
    <schema:funding>Die vorliegenden Open Educational Resources wurden durch das Datenkompetenzzentrum QUADRIGA erstellt.

Förderkennzeichen: 16DKZ2034</schema:funding>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_0">
        <schema:description>Zweck, Zielgruppen, Abgrenzung zu den Manuals.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_0_objective_0" />
        <schema:name>Überblick</schema:name>
        <schema:teaches>Sie können Zweck und Zielgruppen des QUADRIGA Space benennen und ihn von den Manuals abgrenzen.</schema:teaches>
        <schema:timeRequired>PT15M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/kapitel/01-ueberblick.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_1">
        <schema:description>Komponenten und ihr Zusammenspiel, Schnittstellen zum Navigator, Datenflüsse.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_1_objective_0" />
        <schema:name>Architektur</schema:name>
        <schema:teaches>Sie können die Architektur und das Zusammenspiel der Komponenten des QUADRIGA Space beschreiben.</schema:teaches>
        <schema:timeRequired>PT15M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/kapitel/02-architektur.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_2">
        <schema:description>GitHub, JupyterHub, Zenodo, OER-Repositorien: Funktion, Konfiguration, Abhängigkeiten.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_2_objective_0" />
        <schema:name>Komponenten</schema:name>
        <schema:teaches>Sie können die eingesetzten Komponenten und ihre Konfiguration einordnen.</schema:teaches>
        <schema:timeRequired>PT15M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/kapitel/03-komponenten.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_3">
        <schema:description>Zugänge und Rechte, Zuständigkeiten, Abläufe (z. B. neue Fallstudie veröffentlichen, Kurs auf dem JupyterHub einrichten).</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_3_objective_0" />
        <schema:name>Administration</schema:name>
        <schema:teaches>Sie können typische Administrationsabläufe im QUADRIGA Space durchführen.</schema:teaches>
        <schema:timeRequired>PT15M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/kapitel/04-administration.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_4">
        <schema:description>Ressourcenbedarf, Kosten, Wartung, Monitoring, Vorgehen bei Störungen.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/#chapter_4_objective_0" />
        <schema:name>Betrieb und Ressourcen</schema:name>
        <schema:teaches>Sie können Ressourcenbedarf und Betriebsaufgaben des QUADRIGA Space einschätzen.</schema:teaches>
        <schema:timeRequired>PT15M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/QUADRIGA-Space/kapitel/05-betrieb-und-ressourcen.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
